PROJECT_DIR="/Users/kevincarr/projects/AppleIIGS/C/VintaNetGS"
GOLDEN_GATE="/Library/GoldenGate221"
SOURCE="vintanetgs_workflow.c"
OBJECT="vintanetgs.obj"
PROGRAM="vintanetgs"

IMAGE="$HOME/projects/AppleIIGS/System601HD.hdv"
IMAGE_TRANSFER_DIR="/Volumes/AppleShare/VintageComputers/Apple IIGS/transfer"
